{
  "expo": {
    "name": "Vali",
    "slug": "Vali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alisson290174.vali"
    },
    "android": {
      "package": "com.alisson290174.vali",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Vali usa suas fotos para anexar uma imagem ao item cadastrado.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4C2B52"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19f83abd-faff-4245-8225-915cea660ffd"
      }
    },
    "owner": "alissonmaciel226"
  }
}
